<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="phone_menu_model">
    <section>
      <item>
        <attribute name="label">Enrol a phone…</attribute>
        <attribute name="action">win.enrol-phone</attribute>
      </item>
      <item>
        <attribute name="label">Un-enrol the phone</attribute>
        <attribute name="action">win.revoke-phone</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
    </section>
  </menu>
  <template class="IdleManagerWindow" parent="GtkApplicationWindow">
    <property name="title">Idle Manager</property>
    <property name="default-width">1280</property>
    <property name="default-height">800</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header_bar">
        <child type="start">
          <object class="GtkButton" id="reload_button">
            <property name="icon-name">view-refresh-symbolic</property>
            <property name="tooltip-text">Reload the focused game (F5)</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="add_game_button">
            <property name="label">Add game</property>
            <property name="tooltip-text">Add a game account</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkToggleButton" id="sidebar_toggle">
            <property name="icon-name">sidebar-show-symbolic</property>
            <property name="active">true</property>
            <property name="tooltip-text">Show or hide the account list (Ctrl+B)</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkMenuButton" id="phone_menu">
            <property name="icon-name">open-menu-symbolic</property>
            <property name="tooltip-text">Menu</property>
            <property name="menu-model">phone_menu_model</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox" id="layout_toggles">
            <property name="tooltip-text">Choose how many games are visible</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkToggleButton" id="layout_single">
                <property name="label">1</property>
                <property name="active">true</property>
                <property name="tooltip-text">One game (Ctrl+1)</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="layout_side_by_side">
                <property name="label">2</property>
                <property name="tooltip-text">Two games (Ctrl+2)</property>
                <property name="group">layout_single</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="layout_grid">
                <property name="label">4</property>
                <property name="tooltip-text">Four games (Ctrl+4)</property>
                <property name="group">layout_single</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="layout_mobile">
                <property name="label">Phone</property>
                <property name="tooltip-text">Show one game at a phone's size</property>
                <property name="group">layout_single</property>
              </object>
            </child>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox" id="pager">
            <property name="tooltip-text">Next account (Shift+Tab)</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton" id="page_previous">
                <property name="icon-name">go-previous-symbolic</property>
                <property name="tooltip-text">Previous page</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="page_readout">
                <property name="width-chars">5</property>
                <style>
                  <class name="numeric"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="page_next">
                <property name="icon-name">go-next-symbolic</property>
                <property name="tooltip-text">Next page</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkBox" id="content">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkRevealer" id="sidebar_revealer">
                <property name="transition-type">slide-right</property>
                <property name="reveal-child">true</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="empty_state">
                <property name="orientation">vertical</property>
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel" id="first_run_label">
                    <property name="label">No games yet — add one to get started.</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="add_first_game_button">
                    <property name="label">Add your first game</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="workspace_empty_label">
                    <property name="label">No games in this workspace</property>
                    <property name="visible">false</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
