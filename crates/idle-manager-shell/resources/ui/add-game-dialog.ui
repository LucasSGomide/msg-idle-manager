<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="IdleManagerAddGameDialog" parent="GtkWindow">
    <property name="title">Add a game</property>
    <property name="modal">true</property>
    <property name="resizable">false</property>
    <property name="default-widget">add_button</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="margin-top">18</property>
        <property name="margin-bottom">18</property>
        <property name="margin-start">18</property>
        <property name="margin-end">18</property>
        <property name="width-request">340</property>
        <child>
          <object class="GtkStack" id="stages">
            <property name="hhomogeneous">true</property>
            <property name="vhomogeneous">false</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">choose</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Choose a game</property>
                        <property name="xalign">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="empty_list_label">
                        <property name="wrap">true</property>
                        <property name="xalign">0</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="list_scroller">
                        <property name="hscrollbar-policy">never</property>
                        <property name="min-content-height">160</property>
                        <property name="max-content-height">260</property>
                        <property name="propagate-natural-height">true</property>
                        <child>
                          <object class="GtkListView" id="game_list">
                            <property name="single-click-activate">true</property>
                            <style>
                              <class name="rich-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="failure_label">
                        <property name="wrap">true</property>
                        <property name="xalign">0</property>
                        <property name="visible">false</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">details</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="chosen_game_label">
                        <property name="xalign">0</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Name for this account</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="name_entry">
                        <property name="activates-default">true</property>
                        <property name="placeholder-text">Main account</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="address_label">
                        <property name="label">Address</property>
                        <property name="xalign">0</property>
                        <property name="margin-top">6</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="address_entry">
                        <property name="activates-default">true</property>
                        <property name="input-purpose">url</property>
                        <property name="placeholder-text">https://…</property>
                        <property name="visible">false</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="halign">end</property>
            <property name="spacing">6</property>
            <property name="margin-top">12</property>
            <child>
              <object class="GtkButton" id="cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="add_button">
                <property name="label">Add</property>
                <property name="sensitive">false</property>
                <property name="receives-default">true</property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
